   "label": "Create New Vault Account",
   "description": "Check to auto-create a dedicated Cash GL account for this vault under the selected parent account.",
   "default": "0"
  },
  {
   "fieldname": "parent_account",
   "fieldtype": "Link",
   "label": "Parent Account (for new account)",
   "options": "Account",
   "depends_on": "eval:doc.create_vault_account == 1",
   "description": "The parent Cash-in-Hand account group under which the new vault account will be created.",
   "get_query": "{ filters: { account_type: 'Cash', is_group: 1 } }"
  },
  {
   "fieldname": "vault_account",
   "fieldtype": "Link",
